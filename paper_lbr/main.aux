\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {T4 causal experiment results.} Left: $T_4$=Sex ($\rho \approx 0.015$); Right: $T_4$=Race ($\max \rho \approx 0.02$). Bars: Prompt (blue), KL-Prompt (purple), FW (orange). Error bars: $\pm 1$ std (3 seeds). Red annotations: $\Delta $(B$-$A) for Prompt---positive on Sex ($+0.0058$), negative on Race ($-0.0041$). FW is immune ($\Delta < \pm 0.001$).}}{2}{figure.caption.7}\protected@file@percent }
\newlabel{fig:t4}{{3}{2}{\textbf {T4 causal experiment results.} Left: $T_4$=Sex ($\rho \approx 0.015$); Right: $T_4$=Race ($\max \rho \approx 0.02$). Bars: Prompt (blue), KL-Prompt (purple), FW (orange). Error bars: $\pm 1$ std (3 seeds). Red annotations: $\Delta $(B$-$A) for Prompt---positive on Sex ($+0.0058$), negative on Race ($-0.0041$). FW is immune ($\Delta < \pm 0.001$)}{figure.caption.7}{}}

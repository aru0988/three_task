\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Experimental design and causal manipulation.} Stage\nonbreakingspace 1 (top): 3-task backbone pre-trained on $T_1$ (Income), $T_2$ (Marital), $T_3$ (Education), then frozen. Stage\nonbreakingspace 2 (bottom): for new task $T_4$, only the projection network and tower are trained. \textbf  {Condition A}: softmax over $[E_1,E_2]$. \textbf  {Condition B}: softmax over $[E_1,E_2,E_3]$. The backbone is identical across conditions $\Rightarrow $ $\Delta $(B$-$A) is causal. FW serves as control ($\Delta _{FW} \approx 0$).}}{1}{figure.caption.5}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:framework}{{1}{1}{\textbf {Experimental design and causal manipulation.} Stage~1 (top): 3-task backbone pre-trained on $T_1$ (Income), $T_2$ (Marital), $T_3$ (Education), then frozen. Stage~2 (bottom): for new task $T_4$, only the projection network and tower are trained. \textbf {Condition A}: softmax over $[E_1,E_2]$. \textbf {Condition B}: softmax over $[E_1,E_2,E_3]$. The backbone is identical across conditions $\Rightarrow $ $\Delta $(B$-$A) is causal. FW serves as control ($\Delta _{FW} \approx 0$)}{figure.caption.5}{}}
\newlabel{fig:framework@cref}{{[figure][1][]1}{[1][1][]1}{}{}{}}
\citation{asuncion2007uci}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Attention mechanism under pool size manipulation.} \textbf  {Left (Condition A, 2-source):} Query $\mathbf  {h}_p$ attends over $[\mathbf  {E}_1, \mathbf  {E}_2]$ via scaled dot-product ($\div \tau =150$) followed by softmax, producing weights $W_1, W_2$. \textbf  {Right (Condition B, 3-source):} $\mathbf  {E}_3$ enters the candidate pool. The softmax now distributes attention over 3 candidates, diluting $W_1$ (0.62$\rightarrow $0.47) and $W_2$ (0.38$\rightarrow $0.30). When $\mathbf  {E}_3$ carries task-relevant signal, the dilution is offset by useful information from the new candidate. When $\mathbf  {E}_3$ is irrelevant, the dilution is pure noise. Red arrows mark the ``dilution effect.'' Dashed gray lines show the fixed-weight baseline (FW), demonstrating that FW is unaffected by pool size.}}{2}{figure.caption.6}\protected@file@percent }
\newlabel{fig:attention_detail}{{2}{2}{\textbf {Attention mechanism under pool size manipulation.} \textbf {Left (Condition A, 2-source):} Query $\mathbf {h}_p$ attends over $[\mathbf {E}_1, \mathbf {E}_2]$ via scaled dot-product ($\div \tau =150$) followed by softmax, producing weights $W_1, W_2$. \textbf {Right (Condition B, 3-source):} $\mathbf {E}_3$ enters the candidate pool. The softmax now distributes attention over 3 candidates, diluting $W_1$ (0.62$\rightarrow $0.47) and $W_2$ (0.38$\rightarrow $0.30). When $\mathbf {E}_3$ carries task-relevant signal, the dilution is offset by useful information from the new candidate. When $\mathbf {E}_3$ is irrelevant, the dilution is pure noise. Red arrows mark the ``dilution effect.'' Dashed gray lines show the fixed-weight baseline (FW), demonstrating that FW is unaffected by pool size}{figure.caption.6}{}}
\newlabel{fig:attention_detail@cref}{{[figure][2][]2}{[1][2][]2}{}{}{}}

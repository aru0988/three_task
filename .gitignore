/.idea/
/result/

dataset/

# ==============================
# 1. Python 缓存与运行产生的临时文件
# ==============================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==============================
# 2. 虚拟环境 (绝对不能提交！)
# ==============================
.venv/
venv/
env/
ENV/

# ==============================
# 3. 编辑器与 IDE 配置文件
# ==============================
.idea/      
.vscode/    
*.swp
*.swo

# ==============================
# 4. 深度学习模型权重与 Checkpoints
# ==============================
# 你的 MMoE/PLE 模型跑出来的权重通常很大，坚决拦截
*.pt
*.pth
*.ckpt
*.h5
*.pb

# ==============================
# 5. 数据集与日志文件
# ==============================
# 像 Census-Income 这种动辄几十兆的数据不要进 Git
*.csv
*.json
*.txt
!requirements.txt  # 注意：排除 requirements.txt，因为它是配方，必须提交
*.log
logs/
tb_logs/           # TensorBoard 日志

# ==============================
# 6. CensusIncome 阶段 2 协议产物（spec 9.2）
# ==============================
# 权重 / 指标 / 日志 / 划分索引一律不入库；SUMMARY.md 是唯一入库产物
artifacts/census_stage2/stage1
artifacts/census_stage2/runs
artifacts/census_stage2/splits
!artifacts/census_stage2/SUMMARY.md

# Universal Representation: raw prediction arrays and JSON evidence are versioned.
!results/universal/**/*.json
results/universal-smoke/
